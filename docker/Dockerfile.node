# One image for bank nodes and the aggregator
FROM python:3.11-slim
WORKDIR /app
# optional extra root CAs (TLS-inspecting networks); docker/certs/*.crt, never committed
COPY docker/certs/ /usr/local/share/ca-certificates/extra/
RUN update-ca-certificates 2>/dev/null || true
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY fedshield/ fedshield/
ENV PYTHONUNBUFFERED=1 FEDSHIELD_WORK=/data/work
